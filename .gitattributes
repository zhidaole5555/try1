# ============================================================
# 换行符规则:写进仓库,不依赖任何一台机器的 Git 配置
# 这条文件比 core.autocrlf 优先级更高
# ============================================================

# 默认:仓库内统一存 LF
* text=auto eol=lf

# ---------- Windows 专属脚本,必须是 CRLF ----------
*.bat   text eol=crlf
*.cmd   text eol=crlf
*.ps1   text eol=crlf

# ---------- Keil 工程文件,保持 Windows 风格 ----------
*.uvprojx text eol=crlf
*.uvoptx  text eol=crlf
*.uvproj  text eol=crlf
*.sct     text eol=crlf
*.s       text eol=crlf

# ---------- 二进制:禁止任何换行符转换,否则文件会被破坏 ----------
*.lib  binary
*.a    binary
*.o    binary
*.d    binary
*.crf  binary
*.axf  binary
*.elf  binary
*.hex  binary
*.bin  binary
*.lst  binary
